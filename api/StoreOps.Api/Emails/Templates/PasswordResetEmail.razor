<EmailLayout StoreName="@Model.StoreName" SupportEmail="@Model.SupportEmail">
    <div style="font-size:20px;font-weight:bold;text-align:center;">Reset your password</div>
    <p style="text-align:center;color:#444444;">
        Hi @Model.Username, someone asked to reset the password for your @Model.StoreName account.
        The link works for @Model.ValidForMinutes minutes.
    </p>
    <EmailButton Href="@Model.ResetUrl" Text="Choose a new password" />
    <p style="text-align:center;color:#666666;font-size:13px;">
        If it wasn't you, ignore this email. Your password stays as it is.
    </p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public PasswordResetEmailModel Model { get; set; } = null!;
}
