<EmailLayout StoreName="@Model.StoreName" SupportEmail="@Model.SupportEmail">
    <div style="font-size:20px;font-weight:bold;text-align:center;">We refunded your payment</div>
    <p style="text-align:center;color:#444444;">
        Hello @Model.ShipTo.RecipientName. @(Model.Note ?? "We couldn't complete this order, so we refunded your payment in full.")
        Refunds usually reach your card within 5 to 10 business days.
    </p>
    <OrderSummary Model="Model" />
    <EmailButton Href="@Model.OrderUrl" Text="See the order" />
</EmailLayout>

@code {
    [Parameter, EditorRequired] public OrderEmailModel Model { get; set; } = null!;
}
