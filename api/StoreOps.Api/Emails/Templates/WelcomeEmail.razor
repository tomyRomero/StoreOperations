<EmailLayout StoreName="@Model.StoreName" SupportEmail="@Model.SupportEmail">
    <div style="font-size:20px;font-weight:bold;text-align:center;">Welcome, @Model.Username!</div>
    <p style="text-align:center;color:#444444;">
        Your @Model.StoreName account is ready. Your orders, addresses and tracking are all in one place.
    </p>
    <EmailButton Href="@Model.ShopUrl" Text="Start browsing" />
</EmailLayout>

@code {
    [Parameter, EditorRequired] public WelcomeEmailModel Model { get; set; } = null!;
}
