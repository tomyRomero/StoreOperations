{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // S3Mock from docker-compose.yml. It accepts any keys, so these are placeholders, not secrets.
  "Storage": {
    "ServiceUrl": "http://localhost:9090",
    "Bucket": "palettehub-dev",
    "ForcePathStyle": true,
    "AccessKey": "local",
    "SecretKey": "local"
  }
}
