# Copy this file to .env.local. Both settings are optional for local development.
# Everything else (database, images, email, Stripe's secret keys) belongs to the .NET API in ../api.

# Where the .NET API listens. Next forwards every /api/* request there, and Server Components call it
# directly. Defaults to http://localhost:5200, the API's local address.
API_URL=http://localhost:5200

# Stripe's publishable key (test mode only: pk_test_...), for the Payment Element at checkout.
# Without it the checkout page says payments aren't set up. The secret keys go in the API's settings.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
