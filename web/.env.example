# Copy this file to .env.local. Every setting is optional for local development.
# Everything else (database, images, email, Stripe's secret keys) belongs to the .NET API in ../api.

# Where the .NET API listens. Next forwards every /api/* request there, and Server Components call it
# directly. Defaults to http://localhost:5200, the API's local address. Set it for `npm run build` too:
# the /api forwarding is fixed when the app is built.
API_URL=http://localhost:5200

# The site's public address, for link previews and the structured data search engines read.
# Defaults to http://localhost:3200.
SITE_URL=http://localhost:3200

# Stripe's publishable key (test mode only: pk_test_...), for the Payment Element at checkout.
# Without it the checkout page says payments aren't set up. The secret keys go in the API's settings.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
