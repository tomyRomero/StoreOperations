# Copy this file to .env.local and fill in the blanks.
# The values below work with the local Docker services (docker compose up -d).
# Each variable is checked at startup by lib/env.ts.

# --- Database --------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017/palettehub

# --- Auth ------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3200
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Site URLs -------------------------------------------------------------
# Public address of the site, used in emails and payment redirects (keep the trailing slash)
NEXT_PUBLIC_URL=http://localhost:3200/
# Address the server uses to call its own API routes
AXIOS_URL=http://localhost:3200/

# --- Stripe (test mode only) -----------------------------------------------
# Optional: the store runs without these, but checkout needs all three.
# Keys must start with sk_test_ / pk_test_; live keys are rejected.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Printed by `stripe listen --forward-to localhost:3200/api/webhooks/checkout`
STRIPE_WEBHOOK_SECRET=

# --- Image storage (S3) ----------------------------------------------------
# Locally these point at S3Mock, which accepts any key. For AWS, leave S3_ENDPOINT empty.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=palettehub
AWS_SECRET_ACCESS_KEY=palettehub-dev-secret
BUCKET_NAME=palettehub-dev
S3_ENDPOINT=http://localhost:9090

# --- Email (SMTP) ----------------------------------------------------------
# Locally this is Mailpit: every email shows up at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Palettehub <orders@palettehub.test>"
